{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "ConnectionStrings": {
    "FlipZA": "Data Source=flipza.db"
  },
  "Takealot": {
    "ApiVersion": "v-1-16-0",
    "UserAgent": "FlipZA/0.1 (+https://github.com/simseza022/FlipZA)",
    "MinRequestIntervalMs": 2500
  },
  "TakealotScraper": {
    "Discovery": {
      "IntervalHours": 12,
      "MaxPagesPerSearch": 2,
      "MinPrice": 200,
      "MaxPrice": 3000,
      "MinReviewCount": 20,
      "RequireInStock": true,
      "MaxTrackedProducts": 150,
      "Searches": [
        { "Query": "power bank", "Department": 16 },
        { "Query": "phone charger", "Department": 16 },
        { "Query": "wireless charger", "Department": 16 },
        { "Query": "usb c cable", "Department": 16 },
        { "Query": "smart watch", "Department": 16 },
        { "Query": "fitness tracker", "Department": 16 },
        { "Query": "car phone holder", "Department": 16 },
        { "Query": "bluetooth earphones", "Department": 15 },
        { "Query": "wireless earbuds", "Department": 15 },
        { "Query": "bluetooth speaker", "Department": 15 },
        { "Query": "wireless mouse", "Department": 13 },
        { "Query": "usb flash drive", "Department": 13 },
        { "Query": "memory card", "Department": 13 },
        { "Query": "usb hub", "Department": 13 },
        { "Query": "webcam", "Department": 13 },
        { "Query": "smart plug", "Department": 13 },
        { "Query": "gaming headset", "Department": 2 },
        { "Query": "gaming mouse", "Department": 2 },
        { "Query": "ring light", "Department": 14 },
        { "Query": "action camera", "Department": 14 }
      ]
    },
    "Refresh": {
      "IntervalHours": 12,
      "InitialDelayMinutes": 30,
      "MaxProductsPerRun": 150
    },
    "ProductIds": []
  }
}
