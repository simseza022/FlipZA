{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "ConnectionStrings": {
    "FlipZA": "Data Source=flipza.db"
  },
  "EngineSettings": {
    "ScrapeIntervalMinutes": 60
  },
  "Takealot": {
    "ApiVersion": "v-1-16-0",
    "UserAgent": "FlipZA/0.1 (+https://github.com/simseza022/FlipZA)",
    "MinRequestIntervalMs": 2500
  },
  "TakealotScraper": {
    "SearchQueries": [ "air fryer" ],
    "MaxPagesPerQuery": 1,
    "ProductIds": [],
    "MaxProductsPerRun": 100
  }
}
