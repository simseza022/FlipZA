{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "ConnectionStrings": {
    "FlipZA": "Data Source=flipza.db"
  },
  "Takealot": {
    "ApiVersion": "v-1-16-0",
    "UserAgent": "FlipZA/0.1 (+https://github.com/simseza022/FlipZA)",
    "MinRequestIntervalMs": 2500
  },
  "Deals": {
    "Fees": {
      "DefaultSuccessFeeRate": 0.15,
      "SuccessFeeRatesByDepartment": {},
      "SuccessFeeRatesByCategory": {},
      "FulfilmentFee": 38,
      "VatRate": 0.15
    },
    "Reseller": {
      "IsVatRegistered": true,
      "SupplierChargesVat": true,
      "InboundShippingPerUnit": 10
    },
    "Gate": {
      "MinNetProfit": 80,
      "MinRoi": 0.25
    }
  },
  "TakealotScraper": {
    "Discovery": {
      "IntervalHours": 12,
      "MaxPagesPerSearch": 2,
      "MinPrice": 200,
      "MaxPrice": 3000,
      "MinReviewCount": 20,
      "RequireInStock": true,
      "MaxTrackedProducts": 150,
      "Import": {
        "GenericBrandNames": [ "Generic", "Unbranded", "No Brand", "Non-Branded", "OEM", "No result" ],
        "UnbrandedOnly": false,
        "ExcludedBrands": [
          "Apple", "Samsung", "Huawei", "Xiaomi", "Oppo", "Nokia", "Sony", "JBL", "Bose", "Beats",
          "Logitech", "Belkin", "Anker", "UGreen", "Baseus", "Mcdodo", "Volkano", "Redisson", "Amplify",
          "SanDisk", "Kingston", "HP", "Lenovo", "Dell", "Asus", "Acer", "Microsoft", "Redragon",
          "Razer", "Hikvision", "TP-Link", "Canon", "GoPro", "Philips", "Panasonic", "Romoss", "Astrum",
          "Defy", "Hisense", "Russell Hobbs", "Edifier", "Soundcore", "Garmin", "Fossil"
        ],
        "ExcludedTitleKeywords": [
          "bluetooth", "wireless", "wifi", "wi-fi", "smart", "rechargeable", "battery", "mah",
          "power bank", "powerbank", "wall charger", "car charger", "charger plug", "solar"
        ]
      },
      "Searches": [
        { "Query": "usb c cable", "Department": 16, "Channel": "Import" },
        { "Query": "lightning cable", "Channel": "Import" },
        { "Query": "car phone holder", "Department": 16, "Channel": "Import" },
        { "Query": "phone stand", "Channel": "Import" },
        { "Query": "laptop stand", "Channel": "Import" },
        { "Query": "watch strap", "Channel": "Import" },
        { "Query": "screen protector", "Channel": "Import" },
        { "Query": "phone case", "Channel": "Import" },
        { "Query": "usb hub", "Department": 13, "Channel": "Import" },
        { "Query": "usb c adapter", "Channel": "Import" },
        { "Query": "hdmi cable", "Channel": "Import" },
        { "Query": "card reader", "Channel": "Import" },
        { "Query": "mouse pad", "Channel": "Import" },
        { "Query": "wired earphones", "Channel": "Import" },
        { "Query": "phone tripod", "Channel": "Import" },
        { "Query": "action camera accessories", "Channel": "Import" },
        { "Query": "laptop sleeve", "Channel": "Import" },
        { "Query": "cable organiser", "Channel": "Import" },

        { "Query": "power bank", "Department": 16, "Channel": "Local" },
        { "Query": "phone charger", "Department": 16, "Channel": "Local" },
        { "Query": "bluetooth earphones", "Department": 15, "Channel": "Local" },
        { "Query": "wireless earbuds", "Department": 15, "Channel": "Local" },
        { "Query": "bluetooth speaker", "Department": 15, "Channel": "Local" },
        { "Query": "smart watch", "Department": 16, "Channel": "Local" },
        { "Query": "wireless mouse", "Department": 13, "Channel": "Local" },
        { "Query": "usb flash drive", "Department": 13, "Channel": "Local" },
        { "Query": "memory card", "Department": 13, "Channel": "Local" },
        { "Query": "gaming headset", "Department": 2, "Channel": "Local" }
      ]
    },
    "Refresh": {
      "IntervalHours": 12,
      "InitialDelayMinutes": 30,
      "MaxProductsPerRun": 150
    },
    "ProductIds": []
  }
}
